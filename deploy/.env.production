# 同行 —— 生产环境变量
#
# 放到 /etc/companion/companion.env，权限 600（属主 companion）
# 生成随机 PIN：head -c 24 /dev/urandom | base64 | tr -d '/+='

# ---------- 模型 ----------
OPENAI_API_KEY=sk-换成你的key
OPENAI_BASE_URL=https://api.minimaxi.com/v1
COMPANION_LLM_MODEL=MiniMax-M3
OPENAI_TIMEOUT=60

# ---------- Web ----------
# 只绑本机，由 nginx 反代。要直接对外暴露才改成 0.0.0.0。
COMPANION_WEB_HOST=127.0.0.1
COMPANION_WEB_PORT=8000

# 必须设！留空 = 不鉴权，任何拿到地址的人都能访问全部聊天记录。
COMPANION_WEB_PIN=改成你的长随机串

# 默认打开的角色。留空 = 自动取库里第一个用户 + 它的第一个角色。
COMPANION_WEB_USER=alice
COMPANION_WEB_PERSONA=小伴

# ---------- 数据 ----------
# 数据库放 /var/lib/companion（systemd 的 StateDirectory），别放代码目录里。
COMPANION_DB_PATH=/var/lib/companion/companion.db
COMPANION_TZ_OFFSET_HOURS=8

# ---------- 记忆触发 ----------
COMPANION_AUTO_MEMORY=1
COMPANION_MEMORY_TRIGGER_MESSAGES=12
COMPANION_MEMORY_IDLE_SECONDS=600
COMPANION_MEMORY_IDLE_MIN_MESSAGES=3
COMPANION_MEMORY_MAX_WAIT_SECONDS=86400
COMPANION_SUMMARY_TRIGGER_FACTS=8
COMPANION_SUMMARY_INTERVAL_SECONDS=21600
COMPANION_TASK_RETRY_COOLDOWN_SECONDS=900

# ---------- 诊断 ----------
# trace 里有私人业务文本，落在服务器本地，不外发。
COMPANION_TRACE=1
