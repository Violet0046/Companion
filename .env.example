# Companion Ever Memory — 环境变量模板
#
# 使用方法：
#   1. 复制本文件到 .env：  cp .env.example .env
#   2. 填入真实值（至少 OPENAI_API_KEY / OPENAI_BASE_URL / COMPANION_LLM_MODEL）
#   3. .env 不会被提交到 git（见 .gitignore）
#
# 所有变量都会通过 AppConfig.from_env() 自动读取（config.py）。
# 命令行工具（companion-cli）和 AppContext 都会用到。

# ---------- LLM（必填） ----------
# OpenAI 兼容协议：OpenAI / DeepSeek / Qwen / 智谱 / 自建 等
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
COMPANION_LLM_MODEL=gpt-4o-mini

# LLM 请求超时（秒），默认 60
# OPENAI_TIMEOUT=60
# 记忆整理单次请求超时（秒），默认 120；由持久任务统一重试，SDK 不叠加重试
# COMPANION_EXTRACTION_TIMEOUT=120

# 后台自动整理（默认开启）；0 关闭新触发，已持久化任务仍会恢复
# COMPANION_AUTO_MEMORY=1
# 记忆：积累 12 条用户新消息，或空闲 10 分钟且至少 3 条用户新消息
# 少量消息从最早未处理用户输入起，最长约 24 小时兜底；生成回复时暂缓
# COMPANION_MEMORY_TRIGGER_MESSAGES=12
# COMPANION_MEMORY_IDLE_SECONDS=600
# COMPANION_MEMORY_IDLE_MIN_MESSAGES=3
# COMPANION_MEMORY_MAX_WAIT_SECONDS=86400
# 摘要：首次自动建立基线；之后积累 8 条实质变化 fact，或实质变化等待 6 小时
# 当前摘要引用的事实失效/修改优先；纯证据/元数据及净变化为零时免模型消费
# COMPANION_SUMMARY_TRIGGER_FACTS=8
# COMPANION_SUMMARY_INTERVAL_SECONDS=21600
# 三次快速尝试后，网络等临时故障冷却约 15 分钟再自动恢复；校验/配置错误停止自动重试
# COMPANION_TASK_RETRY_COOLDOWN_SECONDS=900
# 后台首次结构化整理不请求长思考，唯一一次纠错恢复自适应思考；仅适配明确支持此开关的 MiniMax-M3
# 聊天模式保持原配置；其他模型不注入供应商参数。设 1 可让后台首次调用也使用自适应思考
# COMPANION_BACKGROUND_THINKING=0

# 本地链路诊断默认开启：调用前保存请求，保留逐次原始/部分回复与校验错误
# 文件在数据库同级 traces/，包含私人业务文本；设 0 关闭
# COMPANION_TRACE=1

# ---------- 应用配置（可选） ----------
# SQLite DB 路径（默认 ./memory/companion.db）
# COMPANION_DB_PATH=./memory/companion.db

# 时区偏移（小时），默认 8 = UTC+8（中国）
# COMPANION_TZ_OFFSET_HOURS=8

# 空闲多久自动判定"上一个 session 已结束"（分钟），默认 120
# session 边界不依赖用户按 /quit，服务端自动管理
# 0 = 关闭自动判定（只能手动 /quit）
# COMPANION_IDLE_MINUTES=120

# 历史上下文上限（第几条消息送进 prompt）
# COMPANION_HISTORY_MAX=50

# 拼 system prompt 时取最近多少条对话，默认 20
# COMPANION_RECENT_MESSAGE_LIMIT=20
