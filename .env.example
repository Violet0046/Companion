# Companion Ever Memory — 环境变量模板
#
# 使用方法：
#   1. 复制本文件到 .env：  cp .env.example .env
#   2. 填入真实值（至少 OPENAI_API_KEY / OPENAI_BASE_URL / COMPANION_LLM_MODEL）
#   3. .env 不会被提交到 git（见 .gitignore）
#
# 所有变量都会通过 AppConfig.from_env() 自动读取（config.py）。
# 命令行工具（companion-cli）和 AppContext 都会用到。

# ---------- LLM（必填） ----------
# OpenAI 兼容协议：OpenAI / DeepSeek / Qwen / 智谱 / 自建 等
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
COMPANION_LLM_MODEL=gpt-4o-mini

# LLM 请求超时（秒），默认 60
# OPENAI_TIMEOUT=60

# ---------- 应用配置（可选） ----------
# SQLite DB 路径（默认 ./memory/companion.db）
# COMPANION_DB_PATH=./memory/companion.db

# 时区偏移（小时），默认 8 = UTC+8（中国）
# COMPANION_TZ_OFFSET_HOURS=8

# 空闲多久自动判定"上一个 session 已结束"（分钟），默认 120
# session 边界不依赖用户按 /quit，服务端自动管理
# 0 = 关闭自动判定（只能手动 /quit）
# COMPANION_IDLE_MINUTES=120

# 历史上下文上限（第几条消息送进 prompt）
# COMPANION_HISTORY_MAX=50

# 拼 system prompt 时取最近多少条对话，默认 20
# COMPANION_RECENT_MESSAGE_LIMIT=20