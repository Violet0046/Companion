# Companion Ever Memory — 环境变量模板
#
# 使用方法：
#   1. 复制本文件到 .env：  cp .env.example .env
#   2. 填入真实值（至少 OPENAI_API_KEY / OPENAI_BASE_URL / COMPANION_LLM_MODEL）；已有 .env 不要覆盖
#   3. .env 不会被提交到 git（见 .gitignore）
#
# 应用和 Web 配置由 config.py 读取，调用记录和诊断开关由对应模块读取。
# 已设置的进程环境变量优先于 .env；相对路径基于工作目录，修改配置后重启服务。
# 当前尚未接入 Embedding / Rerank，不存在生效的向量模型 API 配置项。

# ---------- LLM（必填） ----------
# 使用提供聊天接口的 OpenAI 兼容服务；地址与模型 ID 以供应商配置为准。
# 下面三个值都是占位值，必须替换后才能正常生成回复。
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://your-provider.example/v1
COMPANION_LLM_MODEL=replace-with-your-model

# MiniMax-M3.1-Flash 思考强度，默认 low；可选 low / medium / high / xhigh / max。
# 仅该模型自动携带 reasoning_effort，覆盖私聊、群聊、主动联系、协调、整理和摘要。
# M3.1 不支持关闭思考；网页「显示思考过程」仅影响展示，不控制模型强度。
# 其他模型不自动发送这个参数；旧 MiniMax-M3 的后台思考开关见下文。
COMPANION_REASONING_EFFORT=low

# LLM 请求超时（秒），默认 60
# OPENAI_TIMEOUT=60
# 流式请求默认要求服务商返回实际 token 用量；不支持 include_usage 的兼容接口可设 0
# 缺失用量记为未知，不以 0 命中/0 消耗代替，也不自动重试一遍收费请求
# COMPANION_STREAM_USAGE=1
# 后台记忆/摘要结构化请求超时（秒），默认 120；由持久任务统一重试，SDK 不叠加重试
# COMPANION_EXTRACTION_TIMEOUT=120

# 后台自动整理（默认开启）；0 关闭新触发，已持久化任务仍会恢复
# COMPANION_AUTO_MEMORY=1
# 记忆：积累 12 条用户新消息，或空闲 10 分钟且至少 3 条用户新消息
# 少量消息从最早未处理用户输入起，最长约 24 小时兜底；生成回复时暂缓
# COMPANION_MEMORY_TRIGGER_MESSAGES=12
# 跨会话未整理原文预算也由此条数派生：最多 min(40, 2 × 该值) 条，合计正文不超过 4000 字符。
# 原文边界以该角色的成功整理进度为准；任务触发或运行中不代表笔记已经落库。
# COMPANION_MEMORY_IDLE_SECONDS=600
# COMPANION_MEMORY_IDLE_MIN_MESSAGES=3
# COMPANION_MEMORY_MAX_WAIT_SECONDS=86400
# 摘要：首次自动建立基线；之后积累 8 条实质变化 fact，或实质变化等待 6 小时
# 当前摘要引用的事实失效/修改优先；纯证据/元数据及净变化为零时免模型消费
# COMPANION_SUMMARY_TRIGGER_FACTS=8
# COMPANION_SUMMARY_INTERVAL_SECONDS=21600
# 三次快速尝试后，网络等临时故障冷却约 15 分钟再自动恢复；校验/配置错误停止自动重试
# COMPANION_TASK_RETRY_COOLDOWN_SECONDS=900
# 后台首次结构化整理不请求长思考，唯一一次纠错恢复自适应思考；仅适配明确支持此开关的 MiniMax-M3
# 聊天模式保持原配置；其他模型不注入供应商参数。设 1 可让后台首次调用也使用自适应思考
# MiniMax-M3.1-Flash 不使用此关闭/开启开关，各次请求统一使用上面的思考强度。
# COMPANION_BACKGROUND_THINKING=0

# 轻量模型调用记录默认开启；0 关闭文件写入
# 数据库同级 calls/YYYY-MM-DD.jsonl，每次调用一行；文件日期和 started_at 都使用应用时区
# 仅含层级、关联 ID、模型、耗时、实际 token 和错误分类，不保存提示词或回复正文
# 网页 ?debug 的「我」页面可进入调用列表，按筛选统计；旧 COMPANION_TRACE 开关已移除
# COMPANION_CALL_LOG=1
# 开发用严格提示词检查，默认关闭；开启后违规会中止本次请求。
# 长度检查以字符计数，不是 token 限制，也不会自动截断上下文。
# COMPANION_INVARIANT_STRICT=0
# COMPANION_PROMPT_BUDGET_CHARS=40000

# ---------- 应用配置（可选） ----------
# SQLite DB 路径（默认 ./memory/companion.db）
# COMPANION_DB_PATH=./memory/companion.db

# ---------- Web 服务（部署到公网时必看） ----------
# 程序默认监听 0.0.0.0；仅本机或 nginx 反代时，建议显式绑定 127.0.0.1。
# 若需跨设备直连开发服务，再自行改为 0.0.0.0。
# COMPANION_WEB_HOST=127.0.0.1
# COMPANION_WEB_PORT=8000

# 浏览器始终要求账号登录；旧 COMPANION_WEB_PIN 不再使用。

# 可选：未指定角色的后端请求，为指定登录用户选择默认角色。
# 不会自动登录或更改账号归属；页面选择和通知定位仍可指定其他角色。
# COMPANION_WEB_USER=alice
# COMPANION_WEB_PERSONA=小伴

# Web Push 通知联系地址：mailto:你的邮箱 或实际 HTTPS 网站地址；留空不启用
# 推送密钥首次启用时自动生成并保存在私有数据库，备份数据库时一并保留
# 普通私聊、群聊回复和主动消息共用通知链路；每台设备还需在「我」中开启通知。
# iPhone 请从主屏幕应用开启权限；主动联系开关在角色资料和群设置中，不是环境变量。
# COMPANION_PUSH_SUBJECT=https://your-app.example.com

# 固定 UTC 偏移（小时），默认北京时间 +8，不依赖服务器系统时区。
# 用于提示词时间、日额度、主动联系时段及调用日志日期/时间。
# COMPANION_TZ_OFFSET_HOURS=8

# 空闲多久自动判定"上一个 session 已结束"（分钟），默认 120
# session 边界由服务端自动管理，无需用户执行退出命令
# 0 = 关闭空闲判定，不影响后台记忆调度
# COMPANION_IDLE_MINUTES=120

# 聊天模型近期历史的消息条数上限，默认 50 条消息，不是 50 轮。
# 与手机界面每会话最多 50 条的本地缓存是独立限制。
# COMPANION_HISTORY_MAX=50

# 兼容参数：仍可读取，但不控制当前私聊/群聊历史长度；请使用 COMPANION_HISTORY_MAX。
# COMPANION_RECENT_MESSAGE_LIMIT=20

# 浏览器账号认证：先用 account create 绑定原用户；不再使用共享 PIN。
# HTTPS 部署保持 1；只有本机 HTTP 开发显式改为 0。应用不依赖 Tailscale。
COMPANION_WEB_SECURE_COOKIE=1
# 反代后的实际 HTTPS origin，例如 https://your-app.example.com，不带路径；留空按请求识别。
# 用于来源校验，不会自动建立 HTTPS 或反向代理。
COMPANION_WEB_ORIGIN=

# 每个账号默认的新消息/回复任务额度；0 表示不限。
# 按 COMPANION_TZ_OFFSET_HOURS 的自然日重置；账号可通过 account limits 覆盖。
COMPANION_DAILY_MESSAGES=200
COMPANION_CONCURRENT_REPLIES=2

# 兼容模型名：仅在未设置 COMPANION_LLM_MODEL 时回退到 OPENAI_MODEL。
# OPENAI_MODEL=replace-with-your-model
